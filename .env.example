EWELINK_ACCOUNT=you@example.com
EWELINK_PASSWORD=your-password
EWELINK_APP_ID=your-app-id
EWELINK_APP_SECRET=your-app-secret
EWELINK_REGION=eu
EWELINK_AREA_CODE=+1

NATS_SERVERS=nats://127.0.0.1:4222
NATS_USER=
NATS_PASS=
NATS_TOKEN=
NATS_CREDS=
NATS_NAME=ewelink-nats-bridge
NATS_TLS=false
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=
NATS_CONNECT_TIMEOUT=10000
NATS_RECONNECT_TIME_WAIT=3000
NATS_MAX_RECONNECT_ATTEMPTS=-1

SUBJECT_PREFIX=ewelink
PUBLISH_RAW_STATE=true
VERBOSE=false
EXIT_ON_WEBSOCKET_CLOSE=true
