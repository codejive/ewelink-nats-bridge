EWELINK_ACCOUNT=you@example.com
EWELINK_PASSWORD=your-password
EWELINK_APP_ID=your-app-id
EWELINK_APP_SECRET=your-app-secret
EWELINK_REGION=eu
EWELINK_AREA_CODE=+1

NATS_SERVERS=nats://127.0.0.1:4222
NATS_USER=
NATS_PASS=
NATS_TOKEN=
NATS_CREDS=
NATS_NAME=ewelink-nats-bridge
NATS_TLS=false
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=
NATS_CONNECT_TIMEOUT=10000
NATS_RECONNECT_TIME_WAIT=3000
NATS_MAX_RECONNECT_ATTEMPTS=-1

SUBJECT_PREFIX=ewelink
# true: raw JSON and individual keys; false: individual keys; only: raw JSON
PUBLISH_RAW_STATE=true
VERBOSE=false
EXIT_ON_WEBSOCKET_CLOSE=true

# Optional active/standby; provision the dedicated JetStream KV bucket first.
FAILOVER_ENABLED=false
FAILOVER_BUCKET=ewelink_leases
FAILOVER_LEASE_KEY=bridge
# Milliseconds; renewal must be shorter than duration.
FAILOVER_LEASE_DURATION=30000
FAILOVER_RENEWAL_INTERVAL=5000
FAILOVER_RETRY_INTERVAL=2000
